MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=voynich
MYSQL_USER=voynich
MYSQL_PASSWORD=changeme
# Host-side port. Never 3306 — that's the default MySQL port and will
# eventually collide with a native mysqld or another container on it.
MYSQL_HOST_PORT=13306
# Absolute path to a MySQL option file (chmod 600, [client] section with
# user=/password=) bind-mounted into the container as /root/.my.cnf. Create
# it per host — never commit it. See scripts/mysql-backup.sh.
MYSQL_CNF_HOST_PATH=/home/walter/.voynich-mysql.my.cnf
