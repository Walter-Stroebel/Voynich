# Copy to replication/.env (gitignored, matches the repo-root ".env" pattern)
# and fill in real values before bringing anything up.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=voynich

# Dedicated replication account, distinct from the app's MYSQL_USER in the
# main docker-compose.yml — this one authenticates server-to-server, not
# app-to-DB, so it stays separate even though CLAUDE.md's Catalog persistence
# section already explains why the app user itself isn't scoped down.
REPL_USER=repl
REPL_PASSWORD=changeme-repl

# mach1 (primary) and mach2 (replica) — real LAN IPv4 addresses, never
# hostnames/mDNS/IPv6. See README.md's "Test configurations" section.
REPL_PRIMARY_HOST=192.168.2.12
REPL_PRIMARY_PORT=13306
REPL_REPLICA_HOST=192.168.2.23
REPL_REPLICA_PORT=13307
